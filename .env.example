# PostgreSQL (Neon) — get both URLs from your Neon project dashboard
# "Pooled connection" → DATABASE_URL
# "Direct connection" → DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx.pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Your Vercel deployment URL (or localhost for dev)
NEXTAUTH_URL="https://your-app.vercel.app"

# Google OAuth (optional — for social login)
# Get from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Text-to-speech for the audio Bible player (both optional — without either,
# the app falls back to the browser's built-in voice synthesis).
# ElevenLabs is preferred when set (premium narrator-quality voices):
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# OpenAI is used as a fallback (or primary, if ElevenLabs isn't set):
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Resend (optional — enables automated "forgot password" emails).
# Without it, the forgot-password page honestly tells users to email support
# instead of pretending to send a reset link.
# https://resend.com/api-keys
RESEND_API_KEY=""

# api.bible / scripture.api.bible (optional — layers additional translations
# on top of the default Bolls.life provider). Get a key from:
# https://scripture.api.bible/
# Having a key only exposes whatever Bibles it's been granted access to —
# by default that's mostly public-domain translations (a lot of overlap with
# what Bolls already provides for free). Modern copyrighted translations
# (NIV, ESV, NLT, NASB, ...) each require a SEPARATE publisher permission
# request inside your api.bible dashboard before they'll show up here —
# just having the key does not unlock them.
API_BIBLE_KEY=""
