generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth.js v5 required tables ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  highlights      Highlight[]
  bookmarks       Bookmark[]
  notes           Note[]
  readingProgress ReadingProgress?
  planEnrollments PlanEnrollment[]
  settings        UserSettings?
  dailyReadings   DailyReading[]
  sermonNotes     SermonNote[]
  ttsUsage        TtsUsage[]
  passwordResetTokens PasswordResetToken[]
  prayerEntries   PrayerEntry[]
  memoryVerses    MemoryVerse[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Bible Study User Data ────────────────────────────────────────────────────

model Highlight {
  id          String   @id @default(cuid())
  userId      String
  translation String
  book        Int
  chapter     Int
  verse       Int
  color       String   // yellow | green | blue | pink | purple
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, translation, book, chapter, verse])
  @@index([userId, book, chapter])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  translation String
  book        Int
  chapter     Int
  verse       Int
  label       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, translation, book, chapter, verse])
  @@index([userId])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  translation String
  book        Int
  chapter     Int
  verse       Int
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, translation, book, chapter, verse])
  @@index([userId, book, chapter])
}

model ReadingProgress {
  id          String   @id @default(cuid())
  userId      String   @unique
  translation String   @default("KJV")
  book        Int      @default(43)
  chapter     Int      @default(1)
  verse       Int      @default(1)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                 String  @id @default(cuid())
  userId             String  @unique
  fontSize           Int     @default(100) // percent of base reader size (64-140)
  fontFamily         String  @default("serif")
  lineHeight         Float   @default(1.8)
  theme              String  @default("system")
  defaultTranslation String  @default("KJV")
  parallelTranslation String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyReading {
  id           String   @id @default(cuid())
  userId       String
  date         String   // YYYY-MM-DD (stored in UTC)
  chaptersRead Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ─── Caching / cost & abuse control ──────────────────────────────────────────

// Read-through cache of generated TTS audio, keyed by verse reference + voice
// so requests are never trusted to carry arbitrary billable text.
model AudioCache {
  id          String   @id @default(cuid())
  translation String
  book        Int
  chapter     Int
  verse       Int
  voice       String
  service     String // "elevenlabs" | "openai"
  audio       Bytes
  createdAt   DateTime @default(now())

  @@unique([translation, book, chapter, verse, voice, service])
  @@index([createdAt])
}

// Per-user daily character quota for TTS generation (incremented atomically).
model TtsUsage {
  id        String @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD (UTC)
  charCount Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// Read-through cache of cleaned chapter text, so a Bolls.life outage doesn't
// take down previously-read chapters.
model ChapterCache {
  id          String   @id @default(cuid())
  translation String
  book        Int
  chapter     Int
  verses      Json
  fetchedAt   DateTime @default(now())

  @@unique([translation, book, chapter])
}

// Read-through cache of a translation's book list.
model BookListCache {
  id          String   @id @default(cuid())
  translation String   @unique
  books       Json
  fetchedAt   DateTime @default(now())
}

// Sliding-window counters for login/registration rate limiting.
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// ─── Verse Memorization ───────────────────────────────────────────────────────

model MemoryVerse {
  id          String   @id @default(cuid())
  userId      String
  translation String
  book        Int
  chapter     Int
  verse       Int
  addedAt     DateTime @default(now())
  box         Int      @default(1) // Leitner box, 1-5
  nextReview  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, translation, book, chapter, verse])
  @@index([userId, nextReview])
}

// ─── Prayer Journal ───────────────────────────────────────────────────────────

model PrayerEntry {
  id         String    @id @default(cuid())
  userId     String
  title      String    @default("")
  content    String    @default("")
  isAnswered Boolean   @default(false)
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Sermon Notes ────────────────────────────────────────────────────────────

model SermonNote {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled Sermon")
  date      String   // YYYY-MM-DD
  speaker   String   @default("")
  location  String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Reading Plans ────────────────────────────────────────────────────────────

model ReadingPlan {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  totalDays   Int
  coverColor  String  @default("#4F46E5")

  days        PlanDay[]
  enrollments PlanEnrollment[]
}

model PlanDay {
  id        String @id @default(cuid())
  planId    String
  dayNumber Int
  passages  String // JSON: [{book, chapter, verseStart?, verseEnd?}]
  title     String?

  plan ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dayNumber])
}

model PlanEnrollment {
  id            String    @id @default(cuid())
  userId        String
  planId        String
  startedAt     DateTime  @default(now())
  currentDay    Int       @default(1)
  completedAt   DateTime?
  completedDays String    @default("") // comma-separated day numbers

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
}
